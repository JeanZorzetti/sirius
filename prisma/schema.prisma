// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mercado Pago & Billing
  mercadoPagoCustomerId     String? // Customer ID no Mercado Pago
  mercadoPagoSubscriptionId String? // Subscription ID (assinatura)
  mercadoPagoPreferenceId   String? // Preference ID para checkout
  plan                      String @default("FREE") // FREE, PRO

  users     User[]
  contacts  Contact[]
  deals     Deal[]
  pipelines Pipeline[]
  pipelineStages    PipelineStage[]
  invites   Invite[]
  tags      Tag[]
  emailAutomationSettings EmailAutomationSetting[]
  emailLogs EmailLog[]

  // Analytics relations
  dealSnapshots    DealSnapshot[]
  userActivities   UserActivity[]
  revenueSnapshots RevenueSnapshot[]

  // API & Webhooks
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  webhookLogs  WebhookLog[]

  // Integrations
  n8nEnabled          Boolean  @default(false)
  n8nBaseUrl          String?
  n8nApiKey           String?  // Encrypted with AES-256-GCM
  n8nWebhookUrl       String?

  evolutionEnabled    Boolean  @default(false)
  evolutionBaseUrl    String?
  evolutionApiKey     String?  // Encrypted
  evolutionInstance   String?

  googleCalendarEnabled       Boolean  @default(false)
  googleCalendarRefreshToken  String?  @db.Text // Encrypted
  googleCalendarEmail         String?

  integrationLogs    IntegrationLog[]
  whatsappMessages   WhatsAppMessage[]
  calendarEvents     CalendarEvent[]
  pushSubscriptions  PushSubscription[]
  pwaMetrics         PWAMetric[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String   // Password hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  deals     Deal[]   // Deals managed by this user
  notes     Note[]
  activities Activity[]
  emailLogs EmailLog[]
  userActivities UserActivity[] // Analytics tracking
  pushSubscriptions PushSubscription[]
  pwaMetrics PWAMetric[]
  notificationPreference NotificationPreference?

  role      Role     @default(USER)
  orgRole   OrgRole  @default(OWNER) // Defaulting to OWNER for now so existing users don't lose access. Ideally MEMBER.
}

enum Role {
  USER
  ADMIN
}

enum OrgRole {
  OWNER
  MEMBER
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  deals            Deal[]
  whatsappMessages WhatsAppMessage[]

  // Performance indexes
  @@index([organizationId])
}

model Pipeline {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId, isDefault])
}

model PipelineStage {
  id        String   @id @default(uuid())
  name      String   // "Prospecção", "Qualificação", etc.
  order     Int      // To sort the Kanban columns (1, 2, 3...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals     Deal[]

  // Performance indexes
  @@index([pipelineId, order])
  @@index([organizationId, pipelineId])
}

model Deal {
  id          String   @id @default(uuid())
  title       String   // "Venda Software X"
  value       Decimal? @db.Decimal(10, 2)
  closeDate   DateTime? 
  dueDate     DateTime? // [NEW] Agenda/Follow-up
  order       Int?      // [NEW] Manual sorting in column
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Relations
  pipelineId  String
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id])

  stageId     String
  stage       PipelineStage @relation(fields: [stageId], references: [id])

  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id])

  userId      String
  user        User          @relation(fields: [userId], references: [id])

  // Deal 2.0
  notes       Note[]
  tags        Tag[]
  activities  Activity[]

  // Integrations
  whatsappMessages WhatsAppMessage[]
  calendarEvents   CalendarEvent[]

  // Performance indexes
  @@index([organizationId, stageId])
  @@index([userId])
}

model Invite {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  role      OrgRole  @default(MEMBER)
  expiresAt DateTime
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([email, organizationId])
}

// [NEW] Deal 2.0 Features

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Tag {
  id      String @id @default(uuid())
  name    String
  color   String // hex or preset name
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  deals   Deal[] // Many-to-Many
}

model Activity {
  id        String   @id @default(uuid())
  type      String   // "STAGE_CHANGE", "NOTE_ADDED", "VALUE_CHANGE"
  description String
  createdAt DateTime @default(now())

  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// Email Automation Models

enum EmailAutomationType {
  WELCOME_EMAIL
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  UPGRADE_NUDGE
}

model EmailAutomationSetting {
  id        String   @id @default(uuid())
  type      EmailAutomationType
  enabled   Boolean  @default(true)

  // Customization (nullable = usa template default)
  customSubject String?
  customBody    String? @db.Text

  // Advanced config
  sendDelayMinutes Int @default(0) // 0 = immediate, 60 = 1h, 1440 = 24h
  triggerConditions Json? // Regras de negócio customizadas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model EmailLog {
  id        String   @id @default(uuid())
  type      EmailAutomationType
  to        String
  subject   String
  status    EmailStatus @default(SENT)

  // Tracking timestamps
  sentAt      DateTime @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  // Error handling
  errorMessage String? @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, sentAt])
  @@index([status])
}

// Analytics & Data Warehouse Models

model DealSnapshot {
  id        String   @id @default(uuid())
  date      DateTime // Data do snapshot (sem hora, apenas dia)

  // Métricas agregadas
  totalDeals      Int // Total de deals ativos neste dia
  totalValue      Decimal @db.Decimal(12, 2) // Valor total do pipeline
  avgDealValue    Decimal @db.Decimal(12, 2) // Ticket médio

  // Breakdown por stage
  dealsByStage    Json // { "stageId": { count: X, value: Y } }

  // Breakdown por pipeline
  dealsByPipeline Json // { "pipelineId": { count: X, value: Y } }

  // Conversão
  dealsCreated    Int @default(0) // Deals criados neste dia
  dealsClosed     Int @default(0) // Deals fechados neste dia
  dealsLost       Int @default(0) // Deals perdidos neste dia

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

enum UserActivityType {
  LOGIN
  LOGOUT
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  DEAL_STAGE_CHANGED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  PIPELINE_CREATED
  PIPELINE_DELETED
  EMAIL_SENT
  PAGE_VIEW
  FEATURE_USED
}

model UserActivity {
  id        String   @id @default(uuid())
  type      UserActivityType

  // Contexto do evento
  metadata  Json? // Dados adicionais flexíveis

  // IP e User Agent para analytics
  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RevenueSnapshot {
  id        String   @id @default(uuid())
  date      DateTime // Data do snapshot (último dia do mês)
  month     Int      // 1-12
  year      Int      // 2024, 2025, etc.

  // Métricas de receita
  mrr       Decimal @db.Decimal(12, 2) // Monthly Recurring Revenue
  arr       Decimal @db.Decimal(12, 2) // Annual Recurring Revenue (MRR * 12)

  // Breakdown de clientes
  totalOrganizations    Int // Total de organizações ativas
  freeOrganizations     Int // Orgs no plano FREE
  proOrganizations      Int // Orgs no plano PRO

  // Churn
  churnedOrganizations  Int @default(0) // Orgs que cancelaram neste mês
  newOrganizations      Int @default(0) // Novas orgs neste mês

  // LTV e CAC (quando integrar ads)
  avgLtv    Decimal? @db.Decimal(12, 2) // Lifetime Value médio
  avgCac    Decimal? @db.Decimal(12, 2) // Customer Acquisition Cost

  // Forecast
  forecastNext30d  Decimal? @db.Decimal(12, 2) // Receita prevista próximos 30 dias
  forecastNext60d  Decimal? @db.Decimal(12, 2)
  forecastNext90d  Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  organizationId String? // null = snapshot global de toda a plataforma
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month])
  @@index([year, month])
}

// Public API Models

model ApiKey {
  id        String   @id @default(uuid())
  name      String   // User-friendly name like "Production Key"
  keyHash   String   @unique // bcrypt hash of the API key
  keyPrefix String   // First 12 chars for identification (e.g., "sk_live_1234")
  lastUsed  DateTime?
  expiresAt DateTime?
  requestCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
}

model Webhook {
  id             String   @id @default(uuid())
  svixAppId      String   // Svix application ID
  svixEndpointId String   // Svix endpoint ID
  url            String   // Webhook URL
  description    String?
  enabled        Boolean @default(true)
  events         Json     // ["deal.created", "contact.created"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs           WebhookLog[]

  @@index([organizationId])
  @@index([svixAppId])
}

enum WebhookStatus {
  SUCCESS
  FAILED
  PENDING
  RETRYING
}

model WebhookLog {
  id            String   @id @default(uuid())
  eventType     String   // "deal.created", "deal.updated"
  payload       Json     // Event payload sent
  status        WebhookStatus @default(PENDING)
  statusCode    Int?     // HTTP response code
  errorMessage  String? @db.Text
  attempts      Int @default(0)
  svixMessageId String?  // Svix message ID for tracking
  sentAt        DateTime @default(now())

  webhookId      String
  webhook        Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookId, sentAt])
  @@index([organizationId, eventType, sentAt])
  @@index([status])
}

// Integration Models

enum IntegrationType {
  N8N
  WHATSAPP
  GOOGLE_CALENDAR
}

enum IntegrationStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model IntegrationLog {
  id            String   @id @default(uuid())
  type          IntegrationType
  action        String   // "webhook:deal.created", "api:listWorkflows", "send_message"
  status        IntegrationStatus @default(PENDING)

  // Request/Response data
  request       Json?
  response      Json?
  errorMessage  String?  @db.Text

  // Retry tracking
  attemptCount  Int      @default(1)

  createdAt     DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@index([status, createdAt])
}

model WhatsAppMessage {
  id              String   @id @default(uuid())

  // WhatsApp identifiers
  remoteJid       String   // "5511987654321@s.whatsapp.net"
  messageId       String?  // Evolution API message ID

  // Message content
  text            String   @db.Text
  direction       MessageDirection
  status          WhatsAppMessageStatus @default(PENDING)

  // Media (optional)
  mediaUrl        String?
  mediaType       String?  // "image", "video", "document", "audio"

  // Relations
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Timestamps
  sentAt          DateTime @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sentAt])
  @@index([dealId])
  @@index([contactId])
  @@index([remoteJid])
}

model CalendarEvent {
  id              String   @id @default(uuid())

  // Google Calendar identifier
  googleEventId   String?  @unique

  // Event details
  title           String
  description     String?  @db.Text
  startTime       DateTime
  endTime         DateTime
  location        String?

  // Sync tracking
  syncStatus      SyncStatus @default(PENDING)
  lastSyncAt      DateTime?

  // Relations
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startTime])
  @@index([dealId])
  @@index([googleEventId])
}


model PushSubscription {
  id        String   @id @default(uuid())
  
  // Web Push subscription details
  endpoint  String   @unique
  p256dh    String   // Public key
  auth      String   // Auth secret
  
  // User agent and device info (optional)
  userAgent String?  @db.Text
  deviceType String? // "desktop", "mobile", "tablet"
  
  // Status
  active    Boolean  @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastUsedAt DateTime?
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([organizationId])
  @@index([endpoint])
}

model PWAMetric {
  id        String   @id @default(uuid())
  
  // Event type
  type      PWAMetricType
  
  // User and device info
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  userAgent String?  @db.Text
  deviceType String? // "desktop", "mobile", "tablet"
  
  // Event data (JSON for flexibility)
  data      Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([userId])
}

enum PWAMetricType {
  INSTALL_PROMPT_SHOWN    // beforeinstallprompt event
  INSTALL_PROMPT_ACCEPTED // User clicked "Install"
  INSTALL_PROMPT_DISMISSED // User clicked "Not now"
  APP_INSTALLED           // appinstalled event
  PUSH_PERMISSION_GRANTED // User granted push permission
  PUSH_PERMISSION_DENIED  // User denied push permission
  OFFLINE_SYNC_SUCCESS    // Offline queue synced successfully
  OFFLINE_SYNC_FAILURE    // Offline queue sync failed
  SERVICE_WORKER_UPDATED  // SW updated
}

model NotificationPreference {
  id        String   @id @default(uuid())
  
  // Notification types
  newDealEnabled          Boolean @default(true)
  dealWonEnabled          Boolean @default(true)
  whatsappMessageEnabled  Boolean @default(true)
  calendarReminderEnabled Boolean @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
