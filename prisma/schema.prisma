// ============================================================================
// KNOWLEDGE GRAPH - NLP PIPELINE (Chapter 1.3)
// ============================================================================

// Entity: Represents a node in the knowledge graph
model Entity {
  id          String   @id @default(uuid())
  name        String // Entity name (ex: "CRM", "SPIN Selling")
  wikidataId  String?  @unique // Wikidata Q-code (ex: "Q16635046")
  type        String // Category: methodology, technology, industry, persona, etc.
  description String? // Entity description
  aliases     String[] @default([]) // Alternative names/synonyms
  metadata    Json     @default("{}") // Flexible metadata storage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subjectRelationships Relationship[]  @relation("SubjectEntity")
  objectRelationships  Relationship[]  @relation("ObjectEntity")
  contentLinks         ContentEntity[]

  @@index([type])
  @@index([name])
}

// Relationship: Represents edges in the knowledge graph (RDF triples)
model Relationship {
  id         String   @id @default(uuid())
  subjectId  String
  predicate  String // uses, usedBy, subclassOf, instanceOf, etc.
  objectId   String
  confidence Float    @default(1.0) // 0-1, for AI-extracted relationships
  source     String? // URL or reference of content that originated this
  lastSeen   DateTime @default(now()) // Freshness tracking

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Entity @relation("SubjectEntity", fields: [subjectId], references: [id], onDelete: Cascade)
  object  Entity @relation("ObjectEntity", fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, predicate, objectId])
  @@index([subjectId])
  @@index([objectId])
  @@index([predicate])
  @@index([lastSeen])
}

// EntityExtraction: Tracks NLP pipeline executions
model EntityExtraction {
  id                     String  @id @default(uuid())
  contentType            String // blog_post, documentation, help_article, etc.
  contentId              String? // ID of the content (if applicable)
  contentUrl             String? // URL or path to content
  textSample             String? // First 500 chars of processed text
  contentHash            String? // SHA-256 hash of content for change detection
  extractedEntities      Json    @default("[]") // Array of extracted entity data
  extractedRelationships Json    @default("[]") // Array of extracted relationships
  modelUsed              String? // LLM model identifier
  tokensUsed             Int?
  processingTimeMs       Int?
  status                 String  @default("pending") // pending, processing, completed, failed
  error                  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([contentType])
  @@index([contentId, contentHash]) // For change detection
}

// ContentEntity: Many-to-many relationship between content and entities
model ContentEntity {
  id          String  @id @default(uuid())
  contentType String // blog_post, help_article, etc.
  contentId   String // Slug or ID of the content
  entityId    String
  relevance   Float   @default(1.0) // How relevant this entity is to the content
  context     String? // Sentence/paragraph where entity was found

  createdAt DateTime @default(now())

  // Relations
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([entityId])
}

// ============================================
// CONVERSATIONAL AI - SPIN/Sandler Memory
// ============================================

// ConversationSession: Tracks long-term user conversations with SPIN state
model ConversationSession {
  id        String  @id @default(uuid())
  userId    String? // Optional: link to authenticated user
  sessionId String  @unique // Client-provided session ID (e.g., from cookies)

  // SPIN Selling State
  spinState String @default("Situation") // Situation, Problem, Implication, NeedPayoff

  // Sandler Selling State
  sandlerStage String @default("Bonding") // Bonding, UpfrontContract, PainDiscovery, Budget, Decision, Fulfillment

  // Diagnostic Mode
  diagnosticMode String @default("complete") // express, complete, deep

  // Context tracking
  identifiedProblems Json? // Array of problems user mentioned
  identifiedGoals    Json? // Array of goals/needs user expressed
  entityContext      Json? // Entities extracted from conversation
  qualificationScore Float @default(0.0) // Lead qualification score (0-100)

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  // Relations
  messages ConversationMessage[]

  @@index([userId])
  @@index([sessionId])
  @@index([lastMessageAt])
}

// ConversationMessage: Individual messages in a conversation
model ConversationMessage {
  id        String @id @default(uuid())
  sessionId String
  role      String // user, assistant, system
  content   String @db.Text

  // Metadata for analysis
  spinIntent        String? // Which SPIN question type this was
  extractedEntities Json? // Entities detected in this message
  sentiment         String? // positive, neutral, negative

  createdAt DateTime @default(now())

  // Relations
  session ConversationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// ============================================================================
// CHAT CENTER - CONVERSATION MANAGEMENT (Fase 3.1)
// ============================================================================

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ChatConversation {
  id             String               @id @default(uuid())
  contactId      String               @unique
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?                @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  isPinned       Boolean              @default(false)
  isArchived     Boolean              @default(false)
  lastMessageAt  DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, status])
  @@index([assignedUserId])
  @@index([organizationId, isPinned])
  @@index([organizationId, isArchived])
}

// ============================================================================
// A/B TESTING MODELS
// ============================================================================

// Experiment: A/B test configuration
model Experiment {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  status      String    @default("DRAFT") // DRAFT, RUNNING, PAUSED, COMPLETED
  startDate   DateTime?
  endDate     DateTime?

  // Relations
  variants ExperimentVariant[]
  events   ExperimentEvent[]

  // Ownership
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([status])
}

// ExperimentVariant: Different versions to test
model ExperimentVariant {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  name          String // "control", "variant_a", "variant_b"
  componentName String // Component from registry (e.g., "ROICalculator")
  props         Json // Component props configuration
  trafficWeight Int    @default(50) // 0-100 (percentage of traffic)

  // Relations
  events ExperimentEvent[]

  @@unique([experimentId, name])
  @@index([experimentId])
}

// ExperimentEvent: Tracked user interactions
model ExperimentEvent {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  variantId String
  variant   ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // User tracking
  userId    String? // Optional: logged-in user
  sessionId String // Consistent identifier (cookie/fingerprint)

  // Event data
  eventType String // "impression", "interaction", "conversion"
  metadata  Json? // Additional event data

  // Timestamp
  timestamp DateTime @default(now())

  @@index([experimentId, variantId, eventType])
  @@index([sessionId])
  @@index([timestamp])
}

// Round-Robin Lead Distribution (Business Feature)
model RoundRobinConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled      Boolean  @default(false)
  userIds      String[]
  currentIndex Int      @default(0)

  assignToOwner Boolean @default(false)
  skipIfOffline Boolean @default(true)
  notifyUsers   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Transaction log for payments
model Transaction {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type      TransactionType
  amount    Decimal           @db.Decimal(10, 2)
  feeAmount Decimal?          @db.Decimal(10, 2) // Taxa do gateway (ex: MercadoPago take rate)
  netAmount Decimal?          @db.Decimal(10, 2) // Valor liquido real
  currency  String            @default("BRL")
  status   TransactionStatus @default(PENDING)

  provider          String
  providerPaymentId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([providerPaymentId])
}

enum TransactionType {
