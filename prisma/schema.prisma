// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text // O que a empresa faz (capturado no signup)
  segment     String?  // Segmento de atuação (ex: "Imobiliárias", "Saúde")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Mercado Pago & Billing
  mercadoPagoCustomerId     String? // Customer ID no Mercado Pago
  mercadoPagoSubscriptionId String? // Subscription ID (assinatura)
  mercadoPagoPreferenceId   String? // Preference ID para checkout
  tier                      SubscriptionTier @default(FREE) // FREE, STARTER, PRO, BUSINESS
  plan                      String           @default("FREE") // Deprecated: use tier instead

  // v2.0 Billing enhancements
  customPricing          Decimal?  @db.Decimal(10, 2) // Grandfathering price
  customPricingExpiresAt DateTime? // When grandfathering ends
  grandfatheredDealLimit Int? // FREE clients: custom deal limit (null = use tier limit)
  grandfatheredAt        DateTime? // When grandfathering was applied
  billingPeriod          String    @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  billingStartDate       DateTime? // Start of current billing period
  whatsappInstances      Int       @default(1) // Base WhatsApp instances
  failedPaymentAttempts  Int       @default(0) // Retry logic: downgrade after 3 consecutive failures

  // Flag to exclude from revenue metrics (test users with paid tiers)
  isTestAccount          Boolean   @default(false)

  // Programa de Fundadores
  isFounder     Boolean  @default(false) // True para os primeiros 100 clientes fundadores
  founderNumber Int?                     // Número do fundador (1-100)
  founderSince  DateTime?               // Data de adesão ao programa de fundadores

  // Programa de Indicação
  referrals     Referral[] @relation("ReferredOrgs")

  // Fase 17 - Ads Integration (CAC Real)
  googleAdsCustomerId    String?                // Google Ads Customer ID (ex: 123-456-7890)
  googleAdsRefreshToken  String?   @db.Text     // OAuth2 Refresh Token (encrypted)
  facebookAdAccountId    String?                // Facebook Ad Account ID (ex: act_123456789)
  facebookAccessToken    String?   @db.Text     // Facebook Access Token (encrypted)
  adsIntegrationEnabled  Boolean   @default(false)
  adsLastSyncAt          DateTime?

  // Facebook Lead Ads — webhook
  facebookPageAccessToken  String?  @db.Text   // Page Access Token com leads_retrieval (encrypted)
  facebookPageId           String?             // ID da Página do Facebook
  facebookWebhookVerifyToken String?           // Token de verificação do webhook (plain text)

  users                   User[]
  contacts                Contact[]
  deals                   Deal[]
  pipelines               Pipeline[]
  pipelineStages          PipelineStage[]
  invites                 Invite[]
  tags                    Tag[]
  emailAutomationSettings EmailAutomationSetting[]
  emailLogs               EmailLog[]

  // Analytics relations
  dealSnapshots    DealSnapshot[]
  userActivities   UserActivity[]
  revenueSnapshots RevenueSnapshot[]

  // API & Webhooks
  apiKeys     ApiKey[]
  webhooks    Webhook[]
  webhookLogs WebhookLog[]

  // Integrations
  n8nEnabled    Boolean @default(false)
  n8nBaseUrl    String?
  n8nApiKey     String? // Encrypted with AES-256-GCM
  n8nWebhookUrl String?

  evolutionEnabled  Boolean @default(false)
  evolutionBaseUrl  String?
  evolutionApiKey   String? // Encrypted
  evolutionInstance String?

  // WhatsApp Official API (Meta Cloud API)
  wabaEnabled             Boolean @default(false)
  wabaPhoneNumberId       String?
  wabaAccessToken         String? @db.Text // Encrypted with AES-256-GCM
  wabaBusinessAccountId   String?
  wabaWebhookVerifyToken  String?
  wabaGrandfathered       Boolean @default(false) // Starter/Pro orgs that had access before Business-only gate

  googleCalendarEnabled      Boolean @default(false)
  googleCalendarRefreshToken String? @db.Text // Encrypted
  googleCalendarEmail        String?

  integrationLogs   IntegrationLog[]
  calendarEvents    CalendarEvent[]
  pushSubscriptions PushSubscription[]
  pwaMetrics        PWAMetric[]
  notifications     Notification[]
  adsMetrics        AdsMetric[]
  facebookLeads     FacebookLead[]

  // AGI Sirius relations
  agiConversations   AgiConversation[]
  agiInsights        AgiInsight[]
  agiUsage           AgiUsage[]
  agiSkillExecutions AgiSkillExecution[]

  // A/B Testing
  experiments Experiment[]

  // Onboarding
  onboardingProgress OnboardingProgress[]

  // v2.0 Features
  scrapingCredit        ScrapingCredit?
  scrapingJobs          ScrapingJob[]
  addons                Addon[]
  agiQuota              AgiQuota?
  leadDistributionRules LeadDistributionRule[]

  // v2.0 Planos & Billing
  roundRobinConfig RoundRobinConfig?
  transactions     Transaction[]

  // Chat Center - Conversation Management (Fase 3.1)
  chatConversations ChatConversation[]

  // Deal Automations
  dealAutomations DealAutomation[]

  // Mobile App (Capacitor)
  pushTokens PushToken[]
  visitLogs  VisitLog[]

  // Products (Catálogo)
  products Product[]

  // Task Management
  taskProjects TaskProject[]
  tasks        Task[]

  // AgaaS — Agent Actions, Config & Quota
  agentActions AgentAction[]
  iaConfig     Json?          // Configuração do modo IA (agentes habilitados, thresholds, horários)

  agaasEnabled        Boolean  @default(false)
  agaasAgentLimit     Int      @default(0)   // 0=free, 1=starter, 3=pro, -1=unlimited
  agaasMonthlyQuota   Int      @default(0)   // Ações/mês permitidas (0=free)
  agaasActionsUsed    Int      @default(0)   // Contador reset mensal
  agaasQuotaResetAt   DateTime?              // Próximo reset

  // Access Tracking
  accessSessions AccessSession[]
  pageViewLogs   PageViewLog[]

  // Support Tickets
  supportTickets SupportTicket[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String // Password hash
  jobTitle  String? // Cargo na empresa (ex: "Sócio", "Diretor de Vendas")
  phone     String? // Telefone principal capturado no signup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ROI Labs staff flag — ADMIN = admin cliente, isRoiLabsStaff = equipe ROI Labs
  isRoiLabsStaff Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  deals                  Deal[] // Deals managed by this user
  assignedContacts       Contact[] // Contacts assigned via round-robin
  notes                  Note[]
  activities             Activity[]
  emailLogs              EmailLog[]
  userActivities         UserActivity[] // Analytics tracking
  pushSubscriptions      PushSubscription[]
  pwaMetrics             PWAMetric[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  // AGI Sirius relations
  agiConversations   AgiConversation[]
  agiInsights        AgiInsight[]
  agiUsage           AgiUsage[]
  agiSkillExecutions AgiSkillExecution[]

  // Onboarding
  onboarding OnboardingProgress?

  // Chat Center - Assigned conversations (Fase 3.1)
  assignedConversations ChatConversation[]

  // Mobile App (Capacitor)
  pushTokens PushToken[]
  visitLogs  VisitLog[]

  // Task Management
  tasksAssigned  Task[]         @relation("TaskAssignee")
  tasksCreated   Task[]         @relation("TaskCreator")
  taskComments   TaskComment[]  @relation("TaskCommentAuthor")
  timeEntries    TimeEntry[]    @relation("TimeEntryUser")
  taskActivities    TaskActivity[]   @relation("TaskActivityUser")
  taskAttachments   TaskAttachment[] @relation("TaskAttachmentUploader")

  // Access Tracking
  accessSessions AccessSession[]
  pageViewLogs   PageViewLog[]

  role    Role    @default(USER)
  orgRole OrgRole @default(OWNER) // Defaulting to OWNER for now so existing users don't lose access. Ideally MEMBER.

  // Pipeline visibility (OWNER sees all; MEMBER can be restricted)
  pipelineRestricted Boolean  @default(false) // false = no restriction (all visible)
  allowedPipelineIds String[] // IDs of pipelines this user can see (only used when pipelineRestricted = true)

  // Programa de Indicação
  referralCode     String?   @unique // Código único para indicações
  referralsMade    Referral[] @relation("ReferrerUser")
  referredBy       Referral?  @relation("ReferredUser")

  // Support Tickets
  createdSupportTickets   SupportTicket[]    @relation("SupportTicketCreator")
  assignedSupportTickets  SupportTicket[]    @relation("SupportTicketAssignee")
  supportMessages         SupportMessage[]
  uploadedAttachments     SupportAttachment[]
}

enum Role {
  USER
  ADMIN
}

enum OrgRole {
  OWNER
  MEMBER
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

// Programa de Indicação
model Referral {
  id              String         @id @default(uuid())
  referrerId      String
  referredUserId  String?        @unique
  referredOrgId   String?
  referredEmail   String?        // Email informado no momento do clique (antes do registro)
  status          ReferralStatus @default(PENDING)
  rewardGiven     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  rewardedAt      DateTime?

  referrer        User           @relation("ReferrerUser", fields: [referrerId], references: [id])
  referredUser    User?          @relation("ReferredUser", fields: [referredUserId], references: [id])
  referredOrg     Organization?  @relation("ReferredOrgs", fields: [referredOrgId], references: [id])
}

enum ReferralStatus {
  PENDING   // Código usado, aguardando registro
  ACTIVE    // Usuário registrado, não assinou PRO ainda
  REWARDED  // Usuário assinou PRO — recompensa concedida ao indicador
}

model Contact {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  city          String? // Cidade
  state         String? // Estado (UF)
  profilePicUrl String? // WhatsApp profile picture URL
  latitude      Float?  // Geolocalização — Sprint 4.3
  longitude     Float?  // Geolocalização — Sprint 4.3
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Round-robin assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  deals            Deal[]
  tags             Tag[] // Many-to-Many (Fase 1.2)
  chatConversation ChatConversation? // One-to-One (Fase 3.1)
  tasks            Task[] // Task Management

  // Mobile App (Capacitor)
  visitLogs VisitLog[]

  // Performance indexes
  @@index([organizationId])
  @@index([assignedToId])
}

model Pipeline {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId, isDefault])
}

model PipelineStage {
  id        String   @id @default(uuid())
  name      String // "Prospecção", "Qualificação", etc.
  order     Int // To sort the Kanban columns (1, 2, 3...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals Deal[]

  // Performance indexes
  @@index([pipelineId, order])
  @@index([organizationId, pipelineId])
}

model Deal {
  id        String    @id @default(uuid())
  title     String // "Venda Software X"
  value     Decimal?  @db.Decimal(10, 2)
  closeDate DateTime?
  dueDate   DateTime? // [NEW] Agenda/Follow-up
  order     Int? // [NEW] Manual sorting in column

  // Deal Status (FASE 13 - Analytics)
  status DealStatus @default(ACTIVE)
  lostReason   String? // Motivo da perda (ex: "preço", "timing", "concorrente")
  observations String? // Observações rápidas sobre o deal

  // v2.0: Soft Archive (FREE >50 deals)
  archived       Boolean   @default(false)
  archivedReason String? // "PLAN_LIMIT", "USER_ACTION"
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Relations
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Deal 2.0
  notes      Note[]
  tags       Tag[]
  activities Activity[]

  // Integrations
  calendarEvents   CalendarEvent[]

  // Deal Automations
  automationExecutions AutomationExecution[]

  // Task Management
  tasks Task[]

  // Fechamentos (múltiplas compras por cliente)
  closings DealClosing[]

  // Performance indexes
  @@index([organizationId, stageId])
  @@index([userId])
}

model DealClosing {
  id        String   @id @default(uuid())
  date      DateTime
  value     Decimal  @db.Decimal(10, 2)
  note      String?

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([dealId])
}

model Invite {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  role      OrgRole  @default(MEMBER)
  expiresAt DateTime
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([email, organizationId])
}

// [NEW] Deal 2.0 Features

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Tag {
  id    String @id @default(uuid())
  name  String
  color String // hex or preset name

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  deals    Deal[] // Many-to-Many
  contacts Contact[] // Many-to-Many (Fase 1.2)
}

model Activity {
  id          String   @id @default(uuid())
  type        String // "STAGE_CHANGE", "NOTE_ADDED", "VALUE_CHANGE"
  description String
  createdAt   DateTime @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// Email Automation Models

enum EmailAutomationType {
  WELCOME_EMAIL
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  UPGRADE_NUDGE
}

model EmailAutomationSetting {
  id      String              @id @default(uuid())
  type    EmailAutomationType
  enabled Boolean             @default(true)

  // Customization (nullable = usa template default)
  customSubject String?
  customBody    String? @db.Text

  // Advanced config
  sendDelayMinutes  Int   @default(0) // 0 = immediate, 60 = 1h, 1440 = 24h
  triggerConditions Json? // Regras de negócio customizadas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model EmailLog {
  id      String              @id @default(uuid())
  type    EmailAutomationType
  to      String
  subject String
  status  EmailStatus         @default(SENT)

  // Tracking timestamps
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  // Error handling
  errorMessage String? @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, sentAt])
  @@index([status])
}

// Analytics & Data Warehouse Models

model DealSnapshot {
  id   String   @id @default(uuid())
  date DateTime // Data do snapshot (sem hora, apenas dia)

  // Métricas agregadas
  totalDeals   Int // Total de deals ativos neste dia
  totalValue   Decimal @db.Decimal(12, 2) // Valor total do pipeline
  avgDealValue Decimal @db.Decimal(12, 2) // Ticket médio

  // Breakdown por stage
  dealsByStage Json // { "stageId": { count: X, value: Y } }

  // Breakdown por pipeline
  dealsByPipeline Json // { "pipelineId": { count: X, value: Y } }

  // Conversão
  dealsCreated Int @default(0) // Deals criados neste dia
  dealsClosed  Int @default(0) // Deals fechados neste dia
  dealsLost    Int @default(0) // Deals perdidos neste dia

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

enum UserActivityType {
  LOGIN
  LOGOUT
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  DEAL_STAGE_CHANGED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  PIPELINE_CREATED
  PIPELINE_DELETED
  EMAIL_SENT
  PAGE_VIEW
  FEATURE_USED
}

model UserActivity {
  id   String           @id @default(uuid())
  type UserActivityType

  // Contexto do evento
  metadata Json? // Dados adicionais flexíveis

  // IP e User Agent para analytics
  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RevenueSnapshot {
  id    String   @id @default(uuid())
  date  DateTime // Data do snapshot (último dia do mês)
  month Int // 1-12
  year  Int // 2024, 2025, etc.

  // Métricas de receita
  mrr Decimal @db.Decimal(12, 2) // Monthly Recurring Revenue
  arr Decimal @db.Decimal(12, 2) // Annual Recurring Revenue (MRR * 12)

  // Breakdown de clientes
  totalOrganizations Int // Total de organizações ativas
  freeOrganizations  Int // Orgs no plano FREE
  proOrganizations   Int // Orgs no plano PRO

  // Churn
  churnedOrganizations Int @default(0) // Orgs que cancelaram neste mês
  newOrganizations     Int @default(0) // Novas orgs neste mês

  // LTV e CAC (quando integrar ads)
  avgLtv Decimal? @db.Decimal(12, 2) // Lifetime Value médio
  avgCac Decimal? @db.Decimal(12, 2) // Customer Acquisition Cost

  // Forecast
  forecastNext30d Decimal? @db.Decimal(12, 2) // Receita prevista próximos 30 dias
  forecastNext60d Decimal? @db.Decimal(12, 2)
  forecastNext90d Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  organizationId String? // null = snapshot global de toda a plataforma
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month])
  @@index([year, month])
}

// Public API Models

model ApiKey {
  id           String    @id @default(uuid())
  name         String // User-friendly name like "Production Key"
  keyHash      String    @unique // bcrypt hash of the API key
  keyPrefix    String // First 12 chars for identification (e.g., "sk_live_1234")
  lastUsed     DateTime?
  expiresAt    DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
}

model Webhook {
  id             String   @id @default(uuid())
  svixAppId      String // Svix application ID
  svixEndpointId String // Svix endpoint ID
  url            String // Webhook URL
  description    String?
  enabled        Boolean  @default(true)
  events         Json // ["deal.created", "contact.created"]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs           WebhookLog[]

  @@index([organizationId])
  @@index([svixAppId])
}

enum WebhookStatus {
  SUCCESS
  FAILED
  PENDING
  RETRYING
}

model WebhookLog {
  id            String        @id @default(uuid())
  eventType     String // "deal.created", "deal.updated"
  payload       Json // Event payload sent
  status        WebhookStatus @default(PENDING)
  statusCode    Int? // HTTP response code
  errorMessage  String?       @db.Text
  attempts      Int           @default(0)
  svixMessageId String? // Svix message ID for tracking
  sentAt        DateTime      @default(now())

  webhookId      String
  webhook        Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([webhookId, sentAt])
  @@index([organizationId, eventType, sentAt])
  @@index([status])
}

// Integration Models

enum IntegrationType {
  N8N
  WHATSAPP
  WHATSAPP_OFFICIAL
  GOOGLE_CALENDAR
}

enum IntegrationStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model IntegrationLog {
  id     String            @id @default(uuid())
  type   IntegrationType
  action String // "webhook:deal.created", "api:listWorkflows", "send_message"
  status IntegrationStatus @default(PENDING)

  // Request/Response data
  request      Json?
  response     Json?
  errorMessage String? @db.Text

  // Retry tracking
  attemptCount Int @default(1)

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@index([status, createdAt])
}

model CalendarEvent {
  id String @id @default(uuid())

  // Google Calendar identifier
  googleEventId String? @unique

  // Event details
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  location    String?

  // Sync tracking
  syncStatus SyncStatus @default(PENDING)
  lastSyncAt DateTime?

  // Relations
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startTime])
  @@index([dealId])
  @@index([googleEventId])
}

model PushSubscription {
  id String @id @default(uuid())

  // Web Push subscription details
  endpoint String @unique
  p256dh   String // Public key
  auth     String // Auth secret

  // User agent and device info (optional)
  userAgent  String? @db.Text
  deviceType String? // "desktop", "mobile", "tablet"

  // Status
  active Boolean @default(true)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([endpoint])
}

model PWAMetric {
  id String @id @default(uuid())

  // Event type
  type PWAMetricType

  // User and device info
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  userAgent  String? @db.Text
  deviceType String? // "desktop", "mobile", "tablet"

  // Event data (JSON for flexibility)
  data Json?

  // Timestamps
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([userId])
}

enum PWAMetricType {
  INSTALL_PROMPT_SHOWN // beforeinstallprompt event
  INSTALL_PROMPT_ACCEPTED // User clicked "Install"
  INSTALL_PROMPT_DISMISSED // User clicked "Not now"
  APP_INSTALLED // appinstalled event
  PUSH_PERMISSION_GRANTED // User granted push permission
  PUSH_PERMISSION_DENIED // User denied push permission
  OFFLINE_SYNC_SUCCESS // Offline queue synced successfully
  OFFLINE_SYNC_FAILURE // Offline queue sync failed
  SERVICE_WORKER_UPDATED // SW updated
}

