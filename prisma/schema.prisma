  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, visitedAt])
  @@index([userId])
}

// ============================================================================
// PRODUCTS (Catálogo de Produtos)
// ============================================================================

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int?
  category    String?
  isActive    Boolean  @default(true)
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  deals Deal[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

// ============================================================================
// AGENT ACTIONS (AgaaS — Auditoria de Agentes Autônomos)
// ============================================================================

model AgentAction {
  id             String   @id @default(uuid())
  organizationId String
  agentName      String   // "LeadQualifier", "FollowUpCoordinator", etc.
  actionType     String   // "UPDATE_DEAL", "SEND_WHATSAPP", "CREATE_NOTE", etc.
  entityType     String   // "Deal", "Contact", "WhatsAppMessage"
  entityId       String
  reasoning      String   @db.Text
  confidence     Float    // 0.0 - 1.0
  input          Json
  output         Json?
  status         String   @default("PENDING") // PENDING, NEEDS_APPROVAL, SUCCESS, FAILED
  reviewedBy     String?  // userId que aprovou/rejeitou
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([status])
}

// ============================================================================
// TASK MANAGEMENT (estilo ClickUp)
// ============================================================================

enum TaskStatusType {
  OPEN
  IN_PROGRESS
  DONE
  CLOSED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATED
}

enum TaskVisibility {
  PUBLIC      // Todos os membros da org podem ver
  PRIVATE     // Apenas criador e responsável (assignee) podem ver
  ADMINS_ONLY // Apenas OWNER e ADMIN podem ver
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

// TaskProject: Agrupamento de tarefas (como espaços no ClickUp)
model TaskProject {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  color       String   @default("#6366f1")
  icon        String?
  archived    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  statuses TaskStatus[]
  tasks    Task[]
  labels   TaskLabel[]

  @@index([organizationId])
  @@index([organizationId, archived])
}

// TaskStatus: Colunas customizáveis por projeto
model TaskStatus {
  id        String         @id @default(uuid())
  name      String
  color     String
  type      TaskStatusType @default(OPEN)
  order     Int            @default(0)
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([projectId, order])
}

// TaskLabel: Etiquetas por projeto
model TaskLabel {
  id    String @id @default(uuid())
  name  String
  color String

  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([projectId])
}

// Task: Modelo principal de tarefa
model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?      @db.Text
  priority         TaskPriority @default(NONE)
  order            Int          @default(0)
  dueDate          DateTime?
  startDate        DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  archived         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Projeto e status
  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId String
  status   TaskStatus @relation(fields: [statusId], references: [id])

  // Atribuição
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Subtarefas (hierarquia)
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")

  // Integração CRM
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Visibilidade (controle de acesso)
  visibility TaskVisibility @default(PUBLIC)

  // Organização
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relações
  labels           TaskLabel[]
  comments         TaskComment[]
  checklists       TaskChecklist[]
  attachments      TaskAttachment[]
  timeEntries      TimeEntry[]
  activities       TaskActivity[]
  dependenciesFrom TaskDependency[] @relation("DependencyFrom")
  dependenciesTo   TaskDependency[] @relation("DependencyTo")
  recurrence       TaskRecurrence?

  @@index([organizationId, projectId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, dueDate])
  @@index([projectId, statusId, order])
  @@index([parentId])
  @@index([dealId])
  @@index([contactId])
}

// TaskComment: Comentários em tarefas
model TaskComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskCommentAuthor", fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

// TaskChecklist: Lista de checagem
model TaskChecklist {
  id    String @id @default(uuid())
  title String
  order Int    @default(0)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  items TaskChecklistItem[]

  @@index([taskId])
}

// TaskChecklistItem: Item individual de checklist
model TaskChecklistItem {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  assigneeId  String?

  checklistId String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, order])
}

// TimeEntry: Registro de tempo em tarefas
model TimeEntry {
  id          String    @id @default(uuid())
  description String?
  startTime   DateTime
  endTime     DateTime?
  durationMs  Int?
  billable    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TimeEntryUser", fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId, startTime])
}

// TaskDependency: Dependências entre tarefas
model TaskDependency {
  id   String         @id @default(uuid())
  type DependencyType @default(BLOCKS)

  fromTaskId String
  fromTask   Task   @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)

  toTaskId String
  toTask   Task   @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromTaskId, toTaskId])
  @@index([fromTaskId])
  @@index([toTaskId])
}

// TaskRecurrence: Recorrência de tarefas
model TaskRecurrence {
  id                 String              @id @default(uuid())
  frequency          RecurrenceFrequency
  interval           Int                 @default(1)
  daysOfWeek         Int[]
  dayOfMonth         Int?
  endDate            DateTime?
  maxOccurrences     Int?
  occurrencesCreated Int                 @default(0)
  nextRunAt          DateTime?
  enabled            Boolean             @default(true)

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, enabled])
}

// TaskActivity: Log de atividades da tarefa
model TaskActivity {
  id          String   @id @default(uuid())
  type        String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskActivityUser", fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

// TaskAttachment: Arquivos anexados a tarefas (armazenados no MinIO)
model TaskAttachment {
  id           String   @id @default(uuid())
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  uploadedAt   DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([taskId])
}

// AccessSession: Registra cada sessão de login/logout para calcular tempo médio logado
model AccessSession {
  id        String    @id @default(uuid())
  loginAt   DateTime  @default(now())
  logoutAt  DateTime? // null = sessão ainda ativa
  durationS Int?      // duração em segundos (preenchido no logout ou expiração)

  ipAddress String?
  userAgent String? @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([organizationId, loginAt])
}

// PageViewLog: Registra cada visualização de página para calcular top páginas por org
model PageViewLog {
  id        String   @id @default(uuid())
  path      String   // ex: "/dashboard", "/contacts", "/pipeline/abc"
  pageTitle String?  // título legível da página
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, path])
  @@index([userId, createdAt])
}

// ============================================================================
// SUPPORT TICKETS — Sistema de suporte ROI Labs (Fase suporte)
// ============================================================================

enum TicketStatus {
  OPEN          // Cliente abriu, aguarda staff
  IN_PROGRESS   // Staff respondeu, conversa ativa
  WAITING_USER  // Staff respondeu, aguarda cliente
  RESOLVED      // Staff marcou como resolvido
  CLOSED        // Cliente confirmou ou auto-close
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  BUG
  QUESTION
  FEATURE_REQUEST
  BILLING
  ONBOARDING
  OTHER
}

enum TicketMessageAuthorType {
  USER   // Cliente final
  STAFF  // ROI Labs
  SYSTEM // Mensagens automáticas
}

model SupportTicket {
  id              String          @id @default(uuid())
  subject         String
  description     String          @db.Text
  status          TicketStatus    @default(OPEN)
  priority        TicketPriority  @default(NORMAL)
  category        TicketCategory  @default(QUESTION)

  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdByUser   User            @relation("SupportTicketCreator", fields: [createdByUserId], references: [id])

  assignedStaffId String?
  assignedStaff   User?           @relation("SupportTicketAssignee", fields: [assignedStaffId], references: [id])

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime?
  unreadByUser    Boolean         @default(false)
  unreadByStaff   Boolean         @default(true)

  lastEmailSentAt DateTime?

  messages        SupportMessage[]
  attachments     SupportAttachment[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([assignedStaffId, status])
  @@index([status, priority, createdAt])
}

model SupportMessage {
  id          String                  @id @default(uuid())
  ticketId    String
  ticket      SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType  TicketMessageAuthorType
  authorId    String?
  author      User?                   @relation(fields: [authorId], references: [id])

  content     String                  @db.Text
  isInternal  Boolean                 @default(false)

  attachments SupportAttachment[]

  createdAt   DateTime                @default(now())

  @@index([ticketId, createdAt])
}

model SupportAttachment {
  id           String          @id @default(uuid())
  ticketId     String?
  ticket       SupportTicket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messageId    String?
  message      SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime        @default(now())

  @@index([ticketId])
  @@index([messageId])
}
