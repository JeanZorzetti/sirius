  PLAN_DOWNGRADE
  ADDON_PURCHASE
  REFUND
  CREDIT_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
